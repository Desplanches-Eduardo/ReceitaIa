  "item": [
    {
      "name": "POST Arroz branco",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/food",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "food"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Arroz branco\",\n  \"categoria\": \"CEREAIS\",\n  \"quantidade\": 5,\n  \"validade\": \"2027-06-30\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
